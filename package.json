{
    "name": "pinterval",
    "version": "5.0.0",
    "description": "Advanced interval",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "scripts": {
        "gh-pages": "git subtree push --prefix docs origin gh-pages",
        "clean": "rimraf lib",
        "lint": "eslint src test --ext .ts",
        "build": "cross-env NODE_ENV=production npm run clean && npm run lint && tsc -b tsconfig.json",
        "test": "tsc --noEmit -p tsconfig.test.json && cross-env NODE_ENV=test tsx node_modules/mocha/bin/mocha.js",
        "doc": "rimraf docs && typedoc --excludeProtected --excludePrivate --out docs && touch docs/.nojekyll",
        "fmt": "pretty-quick",
        "prepublishOnly": "npm run test && npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ziflex/pinterval.git"
    },
    "keywords": [
        "interval",
        "setInterval",
        "setinterval",
        "setTimeout",
        "settimeout",
        "delay",
        "poll",
        "polling",
        "repeat",
        "pipeline",
        "promise",
        "async",
        "await"
    ],
    "author": "Tim Voronov <ziflex@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/ziflex/pinterval/issues"
    },
    "homepage": "https://github.com/ziflex/pinterval#readme",
    "dependencies": {},
    "overrides": {
        "mocha": {
            "diff": "8.0.3",
            "serialize-javascript": "7.0.5"
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.2.0",
        "@types/sinon": "^22.0.0",
        "chai": "^6.2.2",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.1",
        "eslint-plugin-chai-friendly": "^1.2.1",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.11.0",
        "mocha": "^11.8.0",
        "prettier": "^3.9.6",
        "pretty-quick": "^4.2.2",
        "rimraf": "^6.1.3",
        "sinon": "^22.1.0",
        "tsx": "^4.23.12",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0"
    }
}
